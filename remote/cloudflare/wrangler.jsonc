{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odic-openbot-signal",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": { "REMOTE_SIGNAL_ENABLED": "false" },
  "containers": [
    {
      "class_name": "SignalContainer",
      "scheduling_policy": "default",
      "image": "../api/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "lite",
      "max_instances": 1,
      "observability": { "enabled": false }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL", "class_name": "SignalContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalContainer"] }]
}
