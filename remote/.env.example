# Reference for owned Cloudflare Worker bindings, not an automatically loaded production environment.
# Use your secret manager or Wrangler stdin. Never copy upstream credentials.
REMOTE_CONTROL_PLANE_URL=https://accounts.example.com
REMOTE_SIGNAL_ORIGIN=https://signal.example.com
# Set only when a website proxy has a different exact HTTPS origin:
# REMOTE_BROWSER_ORIGIN=https://workspace.example.com
REMOTE_SESSION_SECRET=
REMOTE_AUTH_WEBHOOK_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
REMOTE_METRICS_TOKEN=
REMOTE_MAX_CONNECTIONS_PER_USER=32
REMOTE_MAX_CONNECTIONS_PER_IP=32
REMOTE_MAX_MESSAGES_PER_MINUTE=600
# The deployed Worker derives private transport, JWKS, allowed origins and trusted proxy settings.
# Deployment starts disabled. --enable requires a runtime allowance.
# Optional connector credentials must belong to your own apps:
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_MESSAGE_CONTENT=
TELEGRAM_BOT_TOKENS=
TELEGRAM_WEBHOOK_SECRET=
