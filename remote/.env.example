# Reference only. remote:update never loads this file or an encrypted upstream environment.
# Export owned values through the operator's secret manager on the intended Linux host.
REMOTE_DEPLOY_HOST=
ACME_EMAIL=
SIGNAL_DOMAIN=
TURN_DOMAIN=
TURN_PUBLIC_IP=
# Owned Cloudflare zone: DNS Edit and Zone Read, restricted to the required zone(s).
CLOUDFLARE_DNS_API_TOKEN=
ACME_CERTIFICATE_GROUP_ID=2000
REMOTE_SIGNAL_BIND_ADDRESS=0.0.0.0
REMOTE_SIGNAL_PUBLIC_PORT=443
REMOTE_SIGNAL_PORT=8443
REMOTE_TLS_DISABLED=false
REMOTE_TRUST_PROXY=false
REMOTE_CONTROL_PLANE_URL=
REMOTE_TICKET_JWKS_URL=
# Optional inline public JWKS, never a private signing key:
REMOTE_TICKET_PUBLIC_KEYS=
# Optional exact website HTTPS origin when different from the account origin:
# REMOTE_BROWSER_ORIGIN=https://workspace.example.invalid
# Optional explicit origin list; an empty value allows only the released desktop origin.
# REMOTE_ALLOWED_ORIGINS=https://workspace.example.invalid
# Independent random secrets, each at least 32 bytes. Use printable values without whitespace.
REMOTE_SESSION_SECRET=
REMOTE_AUTH_WEBHOOK_SECRET=
TURN_SHARED_SECRET=
# Optional: metrics remain off unless set.
REMOTE_METRICS_TOKEN=
REMOTE_MAX_CONNECTIONS_PER_USER=32
REMOTE_MAX_CONNECTIONS_PER_IP=32
REMOTE_MAX_MESSAGES_PER_MINUTE=600
# Set to the reviewed source commit for image/health provenance.
OPENBOT_SOURCE_COMMIT=
# Optional connectors: only credentials for apps that you own. Blank means off.
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_MESSAGE_CONTENT=
TELEGRAM_BOT_TOKENS=
TELEGRAM_WEBHOOK_SECRET=
# Setting this with Telegram credentials registers webhooks on startup.
TELEGRAM_WEBHOOK_ORIGIN=
