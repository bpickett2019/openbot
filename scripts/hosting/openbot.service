# OpenBot on a self-hosted Linux server. openbot-server-setup selects its service user.
[Unit]
Description=OpenBot hosted server
Wants=network-online.target openbot-update-apply.service
After=network-online.target display-manager.service

[Service]
Type=simple
User=@SERVICE_USER@
RuntimeDirectory=openbot
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/openbot
# As root (+), and OpenBot starts when it fails (-). It installs the update request units when an
# older release moved this one into place; openbot-hosted-update says why.
ExecStartPre=-+/opt/OpenBot/hosted/openbot-hosted-update trigger
ExecStart=/opt/OpenBot/hosted/openbot-hosted-server
# Stops OpenBot before its virtual displays, so that it closes its database first.
ExecStop=/opt/OpenBot/hosted/openbot-hosted-server --stop
Restart=always
RestartSec=10
TimeoutStopSec=60
# Memory guards. The machine is small, and this unit holds OpenBot, its browser tabs and every agent
# process. The OOM killer of the unit acts before the kernel's own, so host services
# keep running. systemd sets -500 as root, before it changes the user; main then gives each
# process it starts 500, so the OOM killer picks an agent process before main. One killed agent does
# not stop the unit: the default policy "stop" would stop OpenBot too.
MemoryMax=90%
OOMScoreAdjust=-500
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
