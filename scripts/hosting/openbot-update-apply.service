# Apply a staged system-server release before OpenBot starts. An interrupted
# replacement completes on the next boot; the staged copy stays until then.
[Unit]
Description=Apply a staged OpenBot update
Before=openbot.service

[Service]
Type=oneshot
# Repeated starts must not replace files under a running OpenBot.
RemainAfterExit=yes
ExecStart=/opt/OpenBot/hosted/openbot-hosted-update boot
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
