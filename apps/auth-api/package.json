{
  "name": "@openbot/auth-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/run-development.ts api",
    "start": "bun run build && bun run preview",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "images": "bun render-content-images.ts",
    "preview": "vite preview --port 3100",
    "deploy": "bun ../../scripts/deploy-auth-api.ts --self-hosted",
    "deploy:check": "bun ../../scripts/deploy-auth-api.ts --self-hosted --check",
    "deploy:test": "bun ../../scripts/deploy-auth-api.ts --env test",
    "env:encrypt:prod": "dotenvx encrypt -f .env.production -fk ../../.env.keys",
    "env:set:smtp": "bun ../../scripts/set-auth-smtp-secret.ts",
    "env:validate:prod": "dotenvx validate -f .env.production -fk ../../.env.keys",
    "cf:typegen": "wrangler types",
    "stripe:bootstrap": "bun ../../scripts/run-development.ts stripe",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun ../../scripts/deploy-auth-api.ts --self-hosted --migrate-only",
    "typecheck": "bun ../../scripts/type-checker.ts --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@kobalte/core": "catalog:",
    "@openbot/brand": "workspace:*",
    "@openbot/contracts": "workspace:*",
    "@openpanel/web": "catalog:",
    "@paper-design/shaders": "catalog:",
    "@solidjs/signals": "catalog:",
    "@solidjs/web": "catalog:",
    "@tanstack/solid-router": "2.0.0-rc.9",
    "@tanstack/solid-start": "2.0.0-rc.9",
    "class-variance-authority": "catalog:",
    "fflate": "catalog:",
    "jose": "catalog:",
    "solid-js": "2.0.0-rc.18",
    "yaml": "catalog:",
    "zod": "catalog:",
    "@openbot/ui": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
