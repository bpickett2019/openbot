{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odic-openbot-accounts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker-entry.ts",
  "workers_dev": true,
  "preview_urls": false,
  "cache": { "enabled": true, "cross_version_cache": false },
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [],
  "secrets": {
    "required": [
      "EMAIL_SMTP_PASSWORD",
      "SKILLS_ADMIN_TOKEN",
      "SITE_REPORT_HASH_SECRET",
      "REMOTE_TICKET_PRIVATE_JWK",
      "REMOTE_TICKET_PUBLIC_JWKS",
      "REMOTE_AUTH_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
    "HOSTED_SERVERS_ENABLED": "false",
    "SITE_PUBLISH_ENABLED": "false",
    "SITE_COOKIE_ISOLATION_READY": "false",
    "REMOTE_TICKET_KEY_ID": "odic-remote-1"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "odic-openbot-accounts", "migrations_dir": "migrations" }],
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "odic-openbot-avatars" },
    { "binding": "SKILLS", "bucket_name": "odic-openbot-skills" },
    { "binding": "SITES", "bucket_name": "odic-openbot-sites" }
  ],
  "ratelimits": [
    {
      "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
      "namespace_id": "2026082702",
      "simple": { "limit": 30, "period": 60 }
    },
    { "name": "MARKETPLACE_UPLOAD_RATE_LIMITER", "namespace_id": "2026082703", "simple": { "limit": 5, "period": 60 } },
    { "name": "SITE_REPORT_RATE_LIMITER", "namespace_id": "2026083101", "simple": { "limit": 10, "period": 60 } },
    { "name": "GITHUB_TOKEN_RATE_LIMITER", "namespace_id": "2026092911", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIVE_ACTIVITY_RATE_LIMITER", "namespace_id": "2026092901", "simple": { "limit": 300, "period": 60 } }
  ],
  "env": {
    "preview": {
      "name": "odic-openbot-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "triggers": { "crons": [] },
      "secrets": { "required": [] },
      "vars": {
        "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
        "HOSTED_SERVERS_ENABLED": "false",
        "SITE_PUBLISH_ENABLED": "false",
        "SITE_COOKIE_ISOLATION_READY": "false"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "odic-openbot-preview", "migrations_dir": "migrations" }],
      "r2_buckets": [
        { "binding": "AVATARS", "bucket_name": "odic-openbot-preview-avatars" },
        { "binding": "SKILLS", "bucket_name": "odic-openbot-preview-skills" },
        { "binding": "SITES", "bucket_name": "odic-openbot-preview-sites" }
      ]
    },
    "test": {
      "name": "odic-openbot-accounts-test",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": ["*/5 * * * *"] },
      "secrets": { "required": [] },
      "vars": {
        "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
        "HOSTED_SERVERS_ENABLED": "false",
        "SITE_PUBLISH_ENABLED": "false",
        "SITE_COOKIE_ISOLATION_READY": "false"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "odic-openbot-accounts-test", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "AVATARS", "bucket_name": "odic-openbot-test-avatars" },
        { "binding": "SKILLS", "bucket_name": "odic-openbot-test-skills" },
        { "binding": "SITES", "bucket_name": "odic-openbot-test-sites" }
      ]
    }
  }
}
